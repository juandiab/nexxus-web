.env
.env.*
!.env.example
node_modules/
dist/
.DS_Store
*.log
__pycache__/
*.pyc

# Product demo videos — too large for git; deploy to server separately
frontend/public/videos/*.mp4
frontend/public/videos/*.webm
frontend/public/videos/*.mov
frontend/public/videos/*-poster.jpg

# TLS certificates and keys — installed on the server out of band
nginx/ssl/*
!nginx/ssl/README.md

# Lead proposal PDFs — private; served only via admin JWT download
backend/data/lead-proposals/

# Stray artifact from `git fetch` run at the repo root
FETCH_HEAD
